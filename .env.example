# Public Firebase web-app configuration. These values identify the Firebase app;
# they are not service-account credentials. Never place private keys in this file.
NEXT_PUBLIC_FIREBASE_API_KEY=replace_with_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=asher-healthcare-clinic.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=asher-healthcare-clinic
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=asher-healthcare-clinic.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_with_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=replace_with_web_app_id

# Server-only Pages Functions configuration. This bucket name is not a secret,
# but report bytes are fetched only by the authenticated, audited API.
FIREBASE_STORAGE_BUCKET=asher-healthcare-clinic.firebasestorage.app

# Server-only Cloudflare secrets used by the report finalizer and audited
# orphan reconciler. Keep real service-account values in encrypted deployment
# variables, never here.
FIREBASE_REPORT_WRITER_CLIENT_EMAIL=replace_me
FIREBASE_REPORT_WRITER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
FIREBASE_REPORT_CLEANUP_CLIENT_EMAIL=replace_me
FIREBASE_REPORT_CLEANUP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
