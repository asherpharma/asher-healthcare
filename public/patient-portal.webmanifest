{
  "id": "/portal",
  "name": "Asher Healthcare Patient & Family Portal",
  "short_name": "Asher Family",
  "description": "Secure family access to Asher Healthcare appointments, prescriptions, reports and receipts.",
  "start_url": "/portal",
  "scope": "/portal",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f8fafc",
  "theme_color": "#233A59",
  "orientation": "portrait-primary",
  "categories": ["medical", "health"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Family portal", "short_name": "Portal", "url": "/portal" },
    { "name": "Book appointment", "short_name": "Book", "url": "/#appointment" }
  ]
}

