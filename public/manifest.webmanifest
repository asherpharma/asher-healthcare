{
  "id": "/admin",
  "name": "Asher Healthcare Staff",
  "short_name": "Asher Staff",
  "description": "Secure mobile clinic workspace for Asher Women & Child Healthcare staff.",
  "start_url": "/admin?source=pwa",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#f8fafc",
  "theme_color": "#233A59",
  "orientation": "portrait-primary",
  "scope": "/admin",
  "categories": ["medical", "business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Appointments",
      "short_name": "Appointments",
      "url": "/admin/appointments"
    },
    {
      "name": "Patients",
      "short_name": "Patients",
      "url": "/admin/patients"
    },
    {
      "name": "Billing",
      "short_name": "Billing",
      "url": "/admin/billing"
    },
    {
      "name": "Lab Desk",
      "short_name": "Lab",
      "url": "/admin/lab"
    }
  ]
}
