rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staffProfile() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffProfile().data.active == true
        && staffProfile().data.role in ['admin', 'doctor', 'reception'];
    }

    function isAdmin() {
      return isStaff() && staffProfile().data.role == 'admin';
    }

    function isReception() {
      return isStaff() && staffProfile().data.role == 'reception';
    }

    function isDoctor() {
      return isStaff() && staffProfile().data.role == 'doctor';
    }

    // Doctor access is tied to the exact assignment stored by the admin staff
    // manager. Avoid display-name/email heuristics in security decisions.
    function staffDoctorId() {
      return staffProfile().data.doctorName == 'Dr. Lt Col Shafi Ahamad'
        ? 'pediatrics'
        : (staffProfile().data.doctorName == 'Dr. Shaik Reshma' ? 'obg' : '');
    }

    function isAssignedAppointmentDoctor() {
      return isDoctor()
        && staffDoctorId() != ''
        && resource.data.doctorId == staffDoctorId();
    }

    function validAppointmentTransition() {
      return (resource.data.status == 'requested'
          && request.resource.data.status in ['confirmed', 'cancelled'])
        || (resource.data.status == 'confirmed'
          && request.resource.data.status in ['checked_in', 'cancelled', 'no_show'])
        || (resource.data.status == 'checked_in'
          && request.resource.data.status in ['waiting', 'in_consultation', 'no_show'])
        || (resource.data.status == 'waiting'
          && request.resource.data.status in ['in_consultation', 'no_show'])
        || (resource.data.status == 'in_consultation'
          && request.resource.data.status in ['completed', 'waiting'])
        || (resource.data.status == 'no_show'
          && request.resource.data.status in ['checked_in', 'cancelled']);
    }

    function validAppointmentQueueUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let keys = request.resource.data.keys();
      return changed.hasOnly([
          'status', 'queueToken', 'checkedInAt', 'waitingAt',
          'consultationStartedAt', 'completedAt', 'noShowAt', 'updatedAt'
        ])
        && request.resource.data.status in [
          'requested', 'confirmed', 'checked_in', 'waiting',
          'in_consultation', 'completed', 'no_show', 'cancelled'
        ]
        && validAppointmentTransition()
        && request.resource.data.updatedAt == request.time
        && (
          !keys.hasAny(['queueToken'])
          || (request.resource.data.queueToken is int
            && request.resource.data.queueToken > 0
            && request.resource.data.queueToken <= 999)
        )
        && (!keys.hasAny(['checkedInAt']) || request.resource.data.checkedInAt == null || request.resource.data.checkedInAt is timestamp)
        && (!keys.hasAny(['waitingAt']) || request.resource.data.waitingAt == null || request.resource.data.waitingAt is timestamp)
        && (!keys.hasAny(['consultationStartedAt']) || request.resource.data.consultationStartedAt == null || request.resource.data.consultationStartedAt is timestamp)
        && (!keys.hasAny(['completedAt']) || request.resource.data.completedAt == null || request.resource.data.completedAt is timestamp)
        && (!keys.hasAny(['noShowAt']) || request.resource.data.noShowAt == null || request.resource.data.noShowAt is timestamp)
        && (!changed.hasAny(['queueToken']) || request.resource.data.status in ['checked_in', 'waiting'])
        && (request.resource.data.status != 'checked_in' || (keys.hasAll(['queueToken']) && changed.hasAll(['checkedInAt'])))
        && (request.resource.data.status != 'waiting' || changed.hasAll(['waitingAt']))
        && (request.resource.data.status != 'in_consultation' || changed.hasAll(['consultationStartedAt']))
        && (request.resource.data.status != 'completed' || changed.hasAll(['completedAt']))
        && (request.resource.data.status != 'no_show' || changed.hasAll(['noShowAt']))
        && (!changed.hasAny(['checkedInAt']) || (request.resource.data.status in ['checked_in', 'waiting'] && request.resource.data.checkedInAt == request.time))
        && (!changed.hasAny(['waitingAt']) || (request.resource.data.status == 'waiting' && request.resource.data.waitingAt == request.time))
        && (!changed.hasAny(['consultationStartedAt']) || (request.resource.data.status == 'in_consultation' && request.resource.data.consultationStartedAt == request.time))
        && (!changed.hasAny(['completedAt']) || (request.resource.data.status == 'completed' && request.resource.data.completedAt == request.time))
        && (!changed.hasAny(['noShowAt']) || (request.resource.data.status == 'no_show' && request.resource.data.noShowAt == request.time))
        && (
          !changed.hasAny(['queueToken'])
          || getAfter(/databases/$(database)/documents/queueCounters/$(resource.data.doctorId)/days/$(resource.data.preferredDate)).data.lastToken
            == request.resource.data.queueToken
        );
    }

    function validReceptionAppointmentTransition() {
      return (resource.data.status == 'requested'
          && request.resource.data.status in ['confirmed', 'cancelled'])
        || (resource.data.status == 'confirmed'
          && request.resource.data.status in ['checked_in', 'cancelled', 'no_show'])
        || (resource.data.status == 'checked_in'
          && request.resource.data.status in ['waiting', 'no_show'])
        || (resource.data.status == 'waiting'
          && request.resource.data.status == 'no_show')
        || (resource.data.status == 'no_show'
          && request.resource.data.status in ['checked_in', 'cancelled']);
    }

    // Temporary rollout bridge for the previous production appointment desk.
    // Remove after all staff clients use the queue workflow: the old UI wrote
    // confirmed -> completed using only status + updatedAt. Doctor assignment
    // remains mandatory, and reception never receives this clinical bridge.
    function validLegacyAppointmentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt'
        ])
        && resource.data.status == 'confirmed'
        && request.resource.data.status == 'completed'
        && request.resource.data.updatedAt == request.time;
    }

    function patientIsActive(patientId) {
      return exists(/databases/$(database)/documents/patients/$(patientId))
        && (
          !get(/databases/$(database)/documents/patients/$(patientId)).data.keys().hasAny(['archived'])
          || get(/databases/$(database)/documents/patients/$(patientId)).data.archived != true
        );
    }

    function isAssignedPatientDoctor(patientId) {
      let patientPath = /databases/$(database)/documents/patients/$(patientId);
      let patient = get(patientPath).data;
      let hasDoctorName = patient.keys().hasAny(['doctorName']);
      let hasCanonicalDoctorName = hasDoctorName
        && patient.doctorName is string
        && patient.doctorName.size() > 0;
      let canUseLegacyDoctorId = !hasDoctorName
        || (patient.doctorName is string && patient.doctorName.size() == 0);
      return isDoctor()
        && exists(patientPath)
        && staffProfile().data.doctorName is string
        && staffProfile().data.doctorName.size() > 0
        && (
          (
            hasCanonicalDoctorName
            && patient.doctorName == staffProfile().data.doctorName
          )
          || (
            canUseLegacyDoctorId
            && staffDoctorId() != ''
            && patient.keys().hasAny(['doctorId'])
            && patient.doctorId == staffDoctorId()
          )
        );
    }

    function canAccessPatientClinical(patientId) {
      return isAdmin() || isAssignedPatientDoctor(patientId);
    }

    function appointmentPatientIsActive() {
      return !resource.data.keys().hasAny(['patientId'])
        || resource.data.patientId == ''
        || patientIsActive(resource.data.patientId);
    }

    function canAccessLabOrder(patientId, clinician) {
      return patientIsActive(patientId)
        && (
          isAdmin()
          || isReception()
          || (
            isAssignedPatientDoctor(patientId)
            && clinician is string
            && clinician == staffProfile().data.doctorName
          )
        );
    }

    function validClinicalCreate(patientId) {
      return canAccessPatientClinical(patientId)
        && patientIsActive(patientId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validClinicalUpdate(patientId) {
      return canAccessPatientClinical(patientId)
        && patientIsActive(patientId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function validReceptionLabReportCreate(patientId) {
      let orderPath = /databases/$(database)/documents/labOrders/$(request.resource.data.labOrderId);
      return isReception()
        && patientIsActive(patientId)
        && request.resource.data.keys().hasAll([
          'fileName', 'storagePath', 'contentType', 'size', 'category',
          'reportDate', 'notes', 'labOrderId', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fileName', 'storagePath', 'contentType', 'size', 'category',
          'reportDate', 'notes', 'labOrderId', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.fileName is string
        && request.resource.data.fileName.size() > 0
        && request.resource.data.fileName.size() <= 200
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches(
          '^reports/' + patientId + '/[0-9]{13}-[A-Za-z0-9._-]+[.](pdf|jpg|jpeg|png|webp)$'
        )
        && request.resource.data.contentType in [
          'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
        ]
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size < 10 * 1024 * 1024
        && request.resource.data.category == 'Lab report'
        && request.resource.data.reportDate is string
        && request.resource.data.reportDate.size() == 10
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.labOrderId is string
        && request.resource.data.labOrderId.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(orderPath)
        && get(orderPath).data.patientId == patientId
        && (
          get(orderPath).data.status in ['ordered', 'collected', 'processing']
          || (
            get(orderPath).data.status == 'completed'
            && !get(orderPath).data.keys().hasAny(['reportStoragePath'])
          )
        );
    }

    function validLabReportAttachment() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let reportKeys = [
        'reportFileName', 'reportStoragePath', 'reportContentType', 'reportSize'
      ];
      return !changedKeys.hasAny(reportKeys)
        || (
          !resource.data.keys().hasAny(reportKeys)
          && changedKeys.hasAll(reportKeys)
          && request.resource.data.keys().hasAll(reportKeys)
          && request.resource.data.reportFileName is string
          && request.resource.data.reportFileName.matches(
            '^[A-Za-z0-9_-]{1,100}[.](pdf|jpg|jpeg|png|webp)$'
          )
          && request.resource.data.reportStoragePath is string
          && request.resource.data.reportStoragePath.matches(
            '^reports/' + resource.data.patientId + '/[0-9]{13}-[A-Za-z0-9._-]+[.](pdf|jpg|jpeg|png|webp)$'
          )
          && request.resource.data.reportContentType in [
            'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
          ]
          && request.resource.data.reportSize is number
          && request.resource.data.reportSize > 0
          && request.resource.data.reportSize < 10 * 1024 * 1024
        );
    }

    function validClinicalReportCreate(patientId) {
      let reportKeys = request.resource.data.keys();
      return validClinicalCreate(patientId)
        && reportKeys.hasAll([
          'fileName', 'storagePath', 'contentType', 'size', 'category',
          'reportDate', 'notes', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && reportKeys.hasOnly([
          'fileName', 'storagePath', 'contentType', 'size', 'category',
          'reportDate', 'notes', 'labOrderId', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.fileName is string
        && request.resource.data.fileName.matches(
          '^[A-Za-z0-9_-]{1,100}[.](pdf|jpg|jpeg|png|webp)$'
        )
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches(
          '^reports/' + patientId + '/[0-9]{13}-[A-Za-z0-9._-]+[.](pdf|jpg|jpeg|png|webp)$'
        )
        && request.resource.data.contentType in [
          'application/pdf', 'image/jpeg', 'image/png', 'image/webp'
        ]
        && request.resource.data.size is number
        && request.resource.data.size > 0
        && request.resource.data.size < 10 * 1024 * 1024
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 100
        && request.resource.data.reportDate is string
        && request.resource.data.reportDate.size() == 10
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && (
          !reportKeys.hasAny(['labOrderId'])
          || (
            request.resource.data.labOrderId is string
            && request.resource.data.labOrderId.matches('^[A-Za-z0-9_-]{1,128}$')
          )
        );
    }

    function validLabCompletionTimestamp() {
      let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
      return !changedKeys.hasAny(['completedAt'])
        || (
          !resource.data.keys().hasAny(['completedAt'])
          && request.resource.data.completedAt == request.time
        );
    }

    match /appointments/{appointmentId} {
      // New appointments are created by the protected booking API so that a
      // doctor/date/time slot can be locked atomically and never double-booked.
      allow create: if false;
      allow read: if isAdmin() || isReception() || isAssignedAppointmentDoctor();
      // Patient, doctor, slot, source, and consent data are immutable. Reception
      // can operate the front-desk queue but cannot start or complete care.
      allow update: if appointmentPatientIsActive()
        && ((
          isAdmin()
          && (validAppointmentQueueUpdate() || validLegacyAppointmentUpdate())
        ) || (
          isReception()
          && validAppointmentQueueUpdate()
          && validReceptionAppointmentTransition()
        ) || (
          isAssignedAppointmentDoctor()
          && (validAppointmentQueueUpdate() || validLegacyAppointmentUpdate())
        ));
      allow delete: if isAdmin();
    }

    match /appointmentSlots/{slotId} {
      // Slot documents contain no patient details and power public live availability.
      allow read: if true;
      allow create, update: if false;
      // A slot is a uniqueness lock. It may be released only when its linked
      // appointment is cancelled in the same atomic batch (or is already
      // cancelled), preventing an orphaned appointment and double booking.
      allow delete: if isStaff()
        && resource.data.appointmentId is string
        && getAfter(/databases/$(database)/documents/appointments/$(resource.data.appointmentId)).data.status == 'cancelled'
        && (
          isAdmin()
          || isReception()
          || (isDoctor() && staffDoctorId() == resource.data.doctorId)
        );
    }

    match /queueCounters/{doctorId}/days/{date} {
      // Per-doctor/day monotonic counters make check-in tokens collision-free.
      // Public clients cannot read or mutate operational queue state.
      allow read: if isStaff();
      allow create: if isStaff()
        && (isAdmin() || isReception() || staffDoctorId() == request.resource.data.doctorId)
        && request.resource.data.keys().hasOnly([
          'doctorId', 'date', 'lastToken', 'appointmentId', 'updatedAt'
        ])
        && request.resource.data.doctorId in ['pediatrics', 'obg']
        && doctorId == request.resource.data.doctorId
        && date == request.resource.data.date
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.lastToken is int
        && request.resource.data.lastToken > 0
        && request.resource.data.lastToken <= 999
        && request.resource.data.appointmentId is string
        && request.resource.data.appointmentId.size() > 0
        && request.resource.data.appointmentId.size() <= 128
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.doctorId == doctorId
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.preferredDate == date
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.queueToken == request.resource.data.lastToken
        && request.resource.data.updatedAt == request.time;
      allow update: if isStaff()
        && (isAdmin() || isReception() || staffDoctorId() == resource.data.doctorId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastToken', 'appointmentId', 'updatedAt'
        ])
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.date == resource.data.date
        && doctorId == resource.data.doctorId
        && date == resource.data.date
        && request.resource.data.lastToken is int
        && request.resource.data.lastToken == resource.data.lastToken + 1
        && request.resource.data.lastToken <= 999
        && request.resource.data.appointmentId is string
        && request.resource.data.appointmentId.size() > 0
        && request.resource.data.appointmentId.size() <= 128
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.doctorId == doctorId
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.preferredDate == date
        && getAfter(/databases/$(database)/documents/appointments/$(request.resource.data.appointmentId)).data.queueToken == request.resource.data.lastToken
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Short-lived, pseudonymous rate-limit markers are written only by the
    // trusted booking service. They are never readable or writable by clients.
    match /bookingGuards/{guardId} {
      allow read, write: if false;
    }

    match /clinicSettings/appointmentSchedule {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.timezone == 'Asia/Kolkata'
        && request.resource.data.enabledDays is list
        && request.resource.data.enabledDays.size() > 0
        && request.resource.data.enabledDays.size() <= 7
        && request.resource.data.doctors is map
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Explicit collection-group access is required for the cross-invoice
    // payment audit feed. Writes remain restricted to the invoice path below.
    match /{path=**}/payments/{paymentId} {
      allow read: if isAdmin() || isReception();
    }

    // The management dashboard reads clinical visits across all patient
    // records. Clinical content stays unavailable to reception accounts;
    // writes remain governed by the patient-specific rules below.
    match /{path=**}/visits/{visitId} {
      allow read: if isAdmin()
        || (
          isDoctor()
          && resource.data.doctorName is string
          && resource.data.doctorName == staffProfile().data.doctorName
        );
    }

    match /invoices/{invoiceId} {
      allow read: if isAdmin() || isReception();
      // Invoice totals and immutable ledger history are owned by protected,
      // idempotent server workflows. No browser client may mutate them.
      allow create, update, delete: if false;

      match /payments/{paymentId} {
        allow read: if isAdmin() || isReception();
        // Payments and reversals are immutable ledger operations owned by the
        // protected server. Financial history is never edited by a browser.
        allow create, update, delete: if false;
      }
    }

    // Payment corrections retain the original payment and append an immutable
    // administrator audit event. This is safer than deleting financial history.
    match /billingAuditLogs/{auditId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Refund operations are written only by the secure Cloudflare service
    // after Razorpay authentication. Administrators can monitor reconciliation.
    match /refundOperations/{operationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /labOrders/{orderId} {
      // Front-desk staff retain read-only lab history after archival. A doctor
      // can query their own canonical clinician history; the UI joins it to the
      // active assigned-patient directory before showing actionable orders.
      allow read: if isAdmin()
        || isReception()
        || (
          isDoctor()
          && resource.data.clinician is string
          && resource.data.clinician == staffProfile().data.doctorName
        );
      allow create: if canAccessLabOrder(
          request.resource.data.patientId,
          request.resource.data.clinician
        )
        && request.resource.data.keys().hasAll([
          'orderNumber', 'patientId', 'patientName', 'patientPhone', 'tests',
          'priority', 'clinician', 'notes', 'status', 'createdBy', 'orderedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNumber', 'patientId', 'patientNumber', 'patientName', 'patientPhone',
          'tests', 'priority', 'clinician', 'notes', 'status', 'createdBy',
          'orderedAt', 'updatedAt'
        ])
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() >= 8
        && request.resource.data.orderNumber.size() <= 40
        && request.resource.data.patientId is string
        && request.resource.data.patientId.size() > 0
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() >= 2
        && request.resource.data.patientName.size() <= 100
        && request.resource.data.patientPhone is string
        && request.resource.data.patientPhone.size() <= 20
        && request.resource.data.tests is list
        && request.resource.data.tests.size() > 0
        && request.resource.data.tests.size() <= 50
        && request.resource.data.priority in ['routine', 'urgent']
        && request.resource.data.clinician is string
        && request.resource.data.clinician.size() <= 100
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.status == 'ordered'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.orderedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if canAccessLabOrder(resource.data.patientId, resource.data.clinician)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resultSummary', 'reportFileName', 'reportStoragePath',
          'reportContentType', 'reportSize', 'specimenCollectedAt',
          'completedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['ordered', 'collected', 'processing', 'completed', 'cancelled']
        && (
          (resource.data.status == 'ordered' && request.resource.data.status in ['ordered', 'collected', 'processing', 'completed', 'cancelled'])
          || (resource.data.status == 'collected' && request.resource.data.status in ['collected', 'processing', 'completed', 'cancelled'])
          || (resource.data.status == 'processing' && request.resource.data.status in ['processing', 'completed', 'cancelled'])
          || (resource.data.status == 'completed' && request.resource.data.status == 'completed')
          || (resource.data.status == 'cancelled' && request.resource.data.status == 'cancelled')
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'resultSummary', 'reportFileName', 'reportStoragePath',
            'reportContentType', 'reportSize', 'completedAt'
          ])
          || request.resource.data.status == 'completed'
        )
        && validLabReportAttachment()
        && validLabCompletionTimestamp()
        && (
          !request.resource.data.keys().hasAny(['resultSummary'])
          || (
            request.resource.data.resultSummary is string
            && request.resource.data.resultSummary.size() <= 5000
          )
        )
        && (
          request.resource.data.status != 'completed'
          || (
            request.resource.data.keys().hasAll(['completedAt'])
            && request.resource.data.completedAt is timestamp
          )
        )
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin() && patientIsActive(resource.data.patientId);
    }

    match /staffTasks/{taskId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasAll([
          'title', 'details', 'type', 'priority', 'status', 'dueDate', 'dueTime',
          'patientId', 'patientName', 'assignedTo', 'assignedToName',
          'createdBy', 'createdAt', 'updatedAt', 'completedAt', 'completedBy'
        ])
        && request.resource.data.keys().hasOnly([
          'title', 'details', 'type', 'priority', 'status', 'dueDate', 'dueTime',
          'patientId', 'patientName', 'assignedTo', 'assignedToName',
          'createdBy', 'createdAt', 'updatedAt', 'completedAt', 'completedBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2
        && request.resource.data.title.size() <= 120
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.type in ['follow_up', 'vaccination', 'lab', 'payment', 'callback', 'general']
        && request.resource.data.priority in ['low', 'medium', 'high', 'urgent']
        && request.resource.data.status == 'open'
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() == 10
        && request.resource.data.dueTime is string
        && request.resource.data.dueTime.size() == 5
        && request.resource.data.patientId is string
        && request.resource.data.patientId.size() <= 40
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() <= 100
        && request.resource.data.assignedTo is string
        && request.resource.data.assignedTo.size() <= 128
        && (
          request.resource.data.assignedTo == ''
          || request.resource.data.assignedTo == request.auth.uid
          || isAdmin()
        )
        && request.resource.data.assignedToName is string
        && request.resource.data.assignedToName.size() <= 100
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.completedAt == null
        && request.resource.data.completedBy == '';
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'completedAt', 'completedBy'
        ])
        && request.resource.data.status in ['open', 'completed']
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'completed'
            && request.resource.data.completedAt == request.time
            && request.resource.data.completedBy == request.auth.uid
          )
          || (
            request.resource.data.status == 'open'
            && request.resource.data.completedAt == null
            && request.resource.data.completedBy == ''
          )
        );
      allow delete: if isAdmin();
    }

    // Clinical audit entries are immutable. Doctors and administrators can
    // append a consultation-completion event, while only administrators can
    // review the clinic-wide audit trail.
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && staffProfile().data.role in ['admin', 'doctor']
        && request.resource.data.keys().hasAll([
          'eventType', 'patientId', 'patientName', 'doctorName',
          'appointmentId', 'consultationId', 'actorUid', 'actorName', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'eventType', 'patientId', 'patientName', 'doctorName',
          'appointmentId', 'consultationId', 'actorUid', 'actorName', 'createdAt'
        ])
        && request.resource.data.eventType == 'consultation.completed'
        && request.resource.data.patientId is string
        && request.resource.data.patientId.size() > 0
        && request.resource.data.patientId.size() <= 40
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() >= 2
        && request.resource.data.patientName.size() <= 100
        && request.resource.data.doctorName is string
        && request.resource.data.doctorName.size() >= 2
        && request.resource.data.doctorName.size() <= 100
        && request.resource.data.appointmentId is string
        && request.resource.data.appointmentId.size() <= 40
        && request.resource.data.consultationId is string
        && request.resource.data.consultationId.size() > 0
        && request.resource.data.consultationId.size() <= 40
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() >= 2
        && request.resource.data.actorName.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /staff/{staffId} {
      allow read: if signedIn() && (request.auth.uid == staffId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Exact patient-identity reservations are maintained only by protected
    // server transactions. Exposing them would leak duplicate-detection data
    // and client writes could detach a reservation from its patient chart.
    match /patientIdentityKeys/{identityKey} {
      allow read, write: if false;
    }

    match /patients/{patientId} {
      // Reception receives only an operational projection from the protected
      // directory API. Doctors can open only charts currently assigned to them.
      allow read: if isAdmin() || isAssignedPatientDoctor(patientId);
      // New arrivals are created only by the protected atomic reception API.
      allow create: if false;
      // Identity, assignment, and clinical-background edits all pass through
      // the protected profile API so the patient and identity-key ownership
      // change atomically with an immutable audit entry.
      allow update: if false;
      // Patient records are archived through the authenticated admin API.
      // Direct client deletion is intentionally disabled so clinical history
      // remains recoverable and every lifecycle change has an audit entry.
      allow delete: if false;

      match /visits/{visitId} {
        allow read: if canAccessPatientClinical(patientId);
        allow create: if validClinicalCreate(patientId);
        allow update: if validClinicalUpdate(patientId);
        allow delete: if false;
      }

      match /prescriptions/{prescriptionId} {
        allow read: if canAccessPatientClinical(patientId);
        allow create: if validClinicalCreate(patientId);
        allow update: if validClinicalUpdate(patientId);
        allow delete: if false;
      }

      match /vaccinations/{vaccinationId} {
        allow read: if canAccessPatientClinical(patientId);
        allow create: if validClinicalCreate(patientId)
          && request.resource.data.keys().hasAll([
            'vaccineName', 'doseNumber', 'administeredDate', 'nextDueDate',
            'batchNumber', 'manufacturer', 'expiryDate', 'route', 'site',
            'administeredBy', 'adverseEvents', 'notes',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'vaccineName', 'doseNumber', 'administeredDate', 'nextDueDate',
            'batchNumber', 'manufacturer', 'expiryDate', 'route', 'site',
            'administeredBy', 'adverseEvents', 'notes',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.vaccineName is string
          && request.resource.data.vaccineName.size() >= 2
          && request.resource.data.vaccineName.size() <= 120
          && request.resource.data.doseNumber is string
          && request.resource.data.doseNumber.size() <= 30
          && request.resource.data.administeredDate is string
          && request.resource.data.administeredDate.size() == 10
          && request.resource.data.nextDueDate is string
          && request.resource.data.nextDueDate.size() <= 10
          && request.resource.data.batchNumber is string
          && request.resource.data.batchNumber.size() <= 80
          && request.resource.data.manufacturer is string
          && request.resource.data.manufacturer.size() <= 100
          && request.resource.data.expiryDate is string
          && request.resource.data.expiryDate.size() <= 10
          && request.resource.data.route in ['', 'IM', 'SC', 'ID', 'oral', 'nasal']
          && request.resource.data.site is string
          && request.resource.data.site.size() <= 80
          && request.resource.data.administeredBy is string
          && request.resource.data.administeredBy.size() <= 100
          && request.resource.data.adverseEvents is string
          && request.resource.data.adverseEvents.size() <= 500
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 500;
        allow update: if validClinicalUpdate(patientId);
        allow delete: if false;
      }

      match /pregnancyRecords/{pregnancyRecordId} {
        allow read: if canAccessPatientClinical(patientId);
        allow create: if validClinicalCreate(patientId)
          && request.resource.data.keys().hasAll([
            'recordedDate', 'lmpDate', 'eddDate', 'gestationalWeeks',
            'bloodPressure', 'weight', 'fetalHeartRate', 'nextVisitDate',
            'gravida', 'para', 'riskLevel', 'riskFactors', 'symptoms',
            'fundalHeight', 'fetalMovement', 'investigations', 'carePlan', 'notes',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'recordedDate', 'lmpDate', 'eddDate', 'gestationalWeeks',
            'bloodPressure', 'weight', 'fetalHeartRate', 'nextVisitDate',
            'gravida', 'para', 'riskLevel', 'riskFactors', 'symptoms',
            'fundalHeight', 'fetalMovement', 'investigations', 'carePlan', 'notes',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.recordedDate is string
          && request.resource.data.recordedDate.size() == 10
          && request.resource.data.lmpDate is string
          && request.resource.data.lmpDate.size() == 10
          && request.resource.data.eddDate is string
          && request.resource.data.eddDate.size() == 10
          && request.resource.data.gestationalWeeks is string
          && request.resource.data.gestationalWeeks.size() <= 20
          && request.resource.data.bloodPressure is string
          && request.resource.data.bloodPressure.size() <= 20
          && request.resource.data.weight is string
          && request.resource.data.weight.size() <= 20
          && request.resource.data.fetalHeartRate is string
          && request.resource.data.fetalHeartRate.size() <= 30
          && request.resource.data.nextVisitDate is string
          && request.resource.data.nextVisitDate.size() <= 10
          && request.resource.data.gravida is string
          && request.resource.data.gravida.size() <= 20
          && request.resource.data.para is string
          && request.resource.data.para.size() <= 20
          && request.resource.data.riskLevel in ['routine', 'moderate', 'high']
          && request.resource.data.riskFactors is string
          && request.resource.data.riskFactors.size() <= 600
          && request.resource.data.symptoms is string
          && request.resource.data.symptoms.size() <= 300
          && request.resource.data.fundalHeight is string
          && request.resource.data.fundalHeight.size() <= 30
          && request.resource.data.fetalMovement is string
          && request.resource.data.fetalMovement.size() <= 120
          && request.resource.data.investigations is string
          && request.resource.data.investigations.size() <= 800
          && request.resource.data.carePlan is string
          && request.resource.data.carePlan.size() <= 800
          && request.resource.data.notes is string
          && request.resource.data.notes.size() <= 800;
        allow update: if validClinicalUpdate(patientId);
        allow delete: if false;
      }

      match /growthRecords/{growthRecordId} {
        allow read: if canAccessPatientClinical(patientId);
        allow create: if validClinicalCreate(patientId)
          && request.resource.data.keys().hasAll([
            'measuredDate', 'weightKg', 'heightCm', 'headCircumferenceCm',
            'bmi', 'milestone', 'nutritionNotes', 'clinician',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'measuredDate', 'weightKg', 'heightCm', 'headCircumferenceCm',
            'bmi', 'milestone', 'nutritionNotes', 'clinician',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.measuredDate is string
          && request.resource.data.measuredDate.size() == 10
          && (request.resource.data.weightKg == null || (request.resource.data.weightKg is number && request.resource.data.weightKg > 0 && request.resource.data.weightKg <= 300))
          && (request.resource.data.heightCm == null || (request.resource.data.heightCm is number && request.resource.data.heightCm >= 10 && request.resource.data.heightCm <= 250))
          && (request.resource.data.headCircumferenceCm == null || (request.resource.data.headCircumferenceCm is number && request.resource.data.headCircumferenceCm >= 10 && request.resource.data.headCircumferenceCm <= 100))
          && (request.resource.data.bmi == null || (request.resource.data.bmi is number && request.resource.data.bmi > 0 && request.resource.data.bmi <= 100))
          && (
            request.resource.data.weightKg != null
            || request.resource.data.heightCm != null
            || request.resource.data.headCircumferenceCm != null
          )
          && request.resource.data.milestone is string
          && request.resource.data.milestone.size() <= 300
          && request.resource.data.nutritionNotes is string
          && request.resource.data.nutritionNotes.size() <= 600
          && request.resource.data.clinician in [
            'Dr. Lt Col Shafi Ahamad',
            'Dr. Shaik Reshma'
          ];
        allow update: if validClinicalUpdate(patientId);
        allow delete: if false;
      }

      match /reports/{reportId} {
        allow read: if canAccessPatientClinical(patientId);
        allow create: if validClinicalReportCreate(patientId)
          || validReceptionLabReportCreate(patientId);
        // The Firestore pointer and the underlying Storage object are one
        // immutable clinical artifact. Corrections create a new version.
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
