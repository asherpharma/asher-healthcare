rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staffProfile() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid));
    }

    function isStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffProfile().data.active == true
        && staffProfile().data.role in ['admin', 'doctor', 'reception'];
    }

    function isAdmin() {
      return isStaff() && staffProfile().data.role == 'admin';
    }

    function validAppointment() {
      return request.resource.data.keys().hasOnly([
          'patientName', 'phone', 'doctorId', 'preferredDate', 'preferredTime',
          'reason', 'status', 'source', 'privacyAccepted', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() >= 2
        && request.resource.data.patientName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20
        && request.resource.data.doctorId in ['pediatrics', 'obg']
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.size() == 10
        && request.resource.data.preferredTime in ['morning', 'afternoon', 'evening']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status == 'requested'
        && request.resource.data.source == 'website'
        && request.resource.data.privacyAccepted == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validStaffAppointment() {
      return isStaff()
        && request.resource.data.keys().hasOnly([
          'patientName', 'phone', 'doctorId', 'preferredDate', 'preferredTime',
          'reason', 'status', 'source', 'privacyAccepted', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() >= 2
        && request.resource.data.patientName.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20
        && request.resource.data.doctorId in ['pediatrics', 'obg']
        && request.resource.data.preferredDate is string
        && request.resource.data.preferredDate.size() == 10
        && request.resource.data.preferredTime in ['morning', 'afternoon', 'evening']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 500
        && request.resource.data.status in ['requested', 'confirmed']
        && request.resource.data.source in ['reception', 'phone', 'walk-in']
        && request.resource.data.privacyAccepted == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validClinicalCreate() {
      return isStaff()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function validClinicalUpdate() {
      return isStaff()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /appointments/{appointmentId} {
      allow create: if validAppointment() || validStaffAppointment();
      allow read: if isStaff();
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['requested', 'confirmed', 'completed', 'cancelled']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasAll([
          'invoiceNumber', 'patientId', 'patientName', 'patientPhone', 'items',
          'subtotal', 'discount', 'total', 'amountPaid', 'balance',
          'paymentStatus', 'paymentMethod', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'invoiceNumber', 'patientId', 'patientNumber', 'patientName', 'patientPhone',
          'items', 'subtotal', 'discount', 'total', 'amountPaid', 'balance',
          'paymentStatus', 'paymentMethod', 'paymentReference', 'notes',
          'createdBy', 'createdAt', 'updatedAt', 'paidAt'
        ])
        && request.resource.data.invoiceNumber is string
        && request.resource.data.invoiceNumber.size() >= 8
        && request.resource.data.invoiceNumber.size() <= 40
        && request.resource.data.patientId is string
        && request.resource.data.patientId.size() > 0
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() >= 2
        && request.resource.data.patientName.size() <= 100
        && request.resource.data.patientPhone is string
        && request.resource.data.patientPhone.size() <= 20
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.subtotal is number
        && request.resource.data.discount is number
        && request.resource.data.total is number
        && request.resource.data.amountPaid is number
        && request.resource.data.balance is number
        && request.resource.data.subtotal >= 0
        && request.resource.data.discount >= 0
        && request.resource.data.discount <= request.resource.data.subtotal
        && request.resource.data.total >= 0
        && request.resource.data.amountPaid >= 0
        && request.resource.data.amountPaid <= request.resource.data.total
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= request.resource.data.total
        && request.resource.data.paymentStatus in ['unpaid', 'partial', 'paid']
        && request.resource.data.paymentMethod in ['cash', 'upi', 'card', 'bank_transfer', 'not_recorded']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amountPaid', 'balance', 'paymentStatus', 'paymentMethod',
          'paymentReference', 'updatedAt', 'paidAt'
        ])
        && request.resource.data.amountPaid is number
        && request.resource.data.balance is number
        && request.resource.data.amountPaid >= resource.data.amountPaid
        && request.resource.data.amountPaid <= resource.data.total
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= resource.data.balance
        && request.resource.data.paymentStatus in ['partial', 'paid']
        && request.resource.data.paymentMethod in ['cash', 'upi', 'card', 'bank_transfer']
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasAll([
            'invoiceId', 'invoiceNumber', 'patientId', 'patientName', 'amount',
            'method', 'source', 'status', 'createdBy', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'invoiceId', 'invoiceNumber', 'patientId', 'patientName', 'amount',
            'method', 'reference', 'source', 'status', 'createdBy', 'createdAt'
          ])
          && request.resource.data.invoiceId == invoiceId
          && request.resource.data.invoiceNumber is string
          && request.resource.data.patientId is string
          && request.resource.data.patientName is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.method in ['cash', 'upi', 'card', 'bank_transfer']
          && request.resource.data.source == 'manual'
          && request.resource.data.status == 'received'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /labOrders/{orderId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasAll([
          'orderNumber', 'patientId', 'patientName', 'patientPhone', 'tests',
          'priority', 'clinician', 'notes', 'status', 'createdBy', 'orderedAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'orderNumber', 'patientId', 'patientNumber', 'patientName', 'patientPhone',
          'tests', 'priority', 'clinician', 'notes', 'status', 'createdBy',
          'orderedAt', 'updatedAt'
        ])
        && request.resource.data.orderNumber is string
        && request.resource.data.orderNumber.size() >= 8
        && request.resource.data.orderNumber.size() <= 40
        && request.resource.data.patientId is string
        && request.resource.data.patientId.size() > 0
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() >= 2
        && request.resource.data.patientName.size() <= 100
        && request.resource.data.patientPhone is string
        && request.resource.data.patientPhone.size() <= 20
        && request.resource.data.tests is list
        && request.resource.data.tests.size() > 0
        && request.resource.data.tests.size() <= 50
        && request.resource.data.priority in ['routine', 'urgent']
        && request.resource.data.clinician is string
        && request.resource.data.clinician.size() <= 100
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.status == 'ordered'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.orderedAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'resultSummary', 'reportFileName', 'reportStoragePath',
          'reportContentType', 'reportSize', 'specimenCollectedAt',
          'completedAt', 'updatedAt'
        ])
        && request.resource.data.status in ['ordered', 'collected', 'processing', 'completed', 'cancelled']
        && (
          (resource.data.status == 'ordered' && request.resource.data.status in ['ordered', 'collected', 'processing', 'completed', 'cancelled'])
          || (resource.data.status == 'collected' && request.resource.data.status in ['collected', 'processing', 'completed', 'cancelled'])
          || (resource.data.status == 'processing' && request.resource.data.status in ['processing', 'completed', 'cancelled'])
          || (resource.data.status == 'completed' && request.resource.data.status == 'completed')
          || (resource.data.status == 'cancelled' && request.resource.data.status == 'cancelled')
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'resultSummary', 'reportFileName', 'reportStoragePath',
            'reportContentType', 'reportSize', 'completedAt'
          ])
          || request.resource.data.status == 'completed'
        )
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }

    match /staff/{staffId} {
      allow read: if signedIn() && (request.auth.uid == staffId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /patients/{patientId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly([
          'patientNumber', 'fullName', 'phone', 'dateOfBirth', 'gender', 'address',
          'allergies', 'medicalHistory', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.patientNumber is string
        && request.resource.data.patientNumber.size() <= 20
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 20
        && request.resource.data.dateOfBirth is string
        && request.resource.data.dateOfBirth.size() == 10
        && request.resource.data.gender in ['female', 'male', 'other']
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.allergies is string
        && request.resource.data.allergies.size() <= 500
        && request.resource.data.medicalHistory is string
        && request.resource.data.medicalHistory.size() <= 1000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fullName', 'phone', 'dateOfBirth', 'gender', 'address', 'allergies',
          'medicalHistory', 'updatedAt'
        ])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();

      match /visits/{visitId} {
        allow read: if isStaff();
        allow create: if validClinicalCreate();
        allow update: if validClinicalUpdate();
        allow delete: if isAdmin();
      }

      match /prescriptions/{prescriptionId} {
        allow read: if isStaff();
        allow create: if validClinicalCreate();
        allow update: if validClinicalUpdate();
        allow delete: if isAdmin();
      }

      match /vaccinations/{vaccinationId} {
        allow read: if isStaff();
        allow create: if validClinicalCreate();
        allow update: if validClinicalUpdate();
        allow delete: if isAdmin();
      }

      match /pregnancyRecords/{pregnancyRecordId} {
        allow read: if isStaff();
        allow create: if validClinicalCreate();
        allow update: if validClinicalUpdate();
        allow delete: if isAdmin();
      }

      match /reports/{reportId} {
        allow read: if isStaff();
        allow create: if validClinicalCreate();
        allow update: if validClinicalUpdate();
        allow delete: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}