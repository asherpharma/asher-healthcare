rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staffProfile() {
      return firestore.get(/databases/(default)/documents/staff/$(request.auth.uid));
    }

    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && staffProfile().data.active == true
        && staffProfile().data.role in ['admin', 'doctor', 'reception'];
    }

    function isAdmin() {
      return isStaff()
        && staffProfile().data.role == 'admin';
    }

    function isReception() {
      return isStaff()
        && staffProfile().data.role == 'reception';
    }

    function isDoctor() {
      return isStaff()
        && staffProfile().data.role == 'doctor';
    }

    function staffDoctorId() {
      return staffProfile().data.doctorName == 'Dr. Lt Col Shafi Ahamad'
        ? 'pediatrics'
        : (staffProfile().data.doctorName == 'Dr. Shaik Reshma' ? 'obg' : '');
    }

    function patientExists(patientId) {
      return firestore.exists(/databases/(default)/documents/patients/$(patientId));
    }

    function patientProfile(patientId) {
      return firestore.get(/databases/(default)/documents/patients/$(patientId));
    }

    function patientIsActive(patientId) {
      return patientExists(patientId)
        && (
          !patientProfile(patientId).data.keys().hasAny(['archived'])
          || patientProfile(patientId).data.archived != true
        );
    }

    function isAssignedDoctor(patientId) {
      return isDoctor()
        && patientExists(patientId)
        && staffProfile().data.doctorName is string
        && staffProfile().data.doctorName.size() > 0
        && staffDoctorId() != ''
        && (
          (
            patientProfile(patientId).data.keys().hasAny(['doctorName'])
            && patientProfile(patientId).data.doctorName is string
            && patientProfile(patientId).data.doctorName.size() > 0
            && patientProfile(patientId).data.doctorName == staffProfile().data.doctorName
          )
          || (
            (
              !patientProfile(patientId).data.keys().hasAny(['doctorName'])
              || (
                patientProfile(patientId).data.doctorName is string
                && patientProfile(patientId).data.doctorName.size() == 0
              )
            )
            && patientProfile(patientId).data.keys().hasAny(['doctorId'])
            && patientProfile(patientId).data.doctorId is string
            && patientProfile(patientId).data.doctorId == staffDoctorId()
          )
        );
    }

    function validReceptionLabOrder(patientId) {
      let metadataKeys = request.resource.metadata.keys();
      let labOrderId = request.resource.metadata.labOrderId;
      let orderPath = /databases/(default)/documents/labOrders/$(labOrderId);
      return metadataKeys.hasAll(['labOrderId'])
        && labOrderId is string
        && labOrderId.matches('^[A-Za-z0-9_-]{1,128}$')
        && firestore.exists(orderPath)
        && firestore.get(orderPath).data.patientId == patientId
        && firestore.get(orderPath).data.status in ['ordered', 'collected', 'processing', 'completed']
        && !firestore.get(orderPath).data.keys().hasAny([
          'reportFileName', 'reportStoragePath', 'reportContentType', 'reportSize'
        ]);
    }

    function validClinicalReportCreate(patientId, fileName) {
      let metadataKeys = request.resource.metadata.keys();
      return patientId.matches('^[A-Za-z0-9_-]{1,128}$')
        && patientIsActive(patientId)
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024
        && fileName.matches('^[0-9]{13}-[A-Za-z0-9._-]+[.](pdf|jpg|jpeg|png|webp)$')
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png|image/webp)$')
        && metadataKeys.hasAll(['patientId', 'uploadedBy'])
        // Laboratory reports are never promoted by a browser. Any object with
        // labOrderId metadata must enter pending-reports and pass the trusted
        // finalizer's byte, linkage, and concurrency checks.
        && metadataKeys.hasOnly(['patientId', 'uploadedBy'])
        && request.resource.metadata.patientId == patientId
        && request.resource.metadata.uploadedBy == request.auth.uid;
    }

    function validPendingReportCreate(patientId, fileName) {
      let metadataKeys = request.resource.metadata.keys();
      return patientId.matches('^[A-Za-z0-9_-]{1,128}$')
        && patientIsActive(patientId)
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && fileName.matches(
          '^[A-Za-z0-9_-]{8,100}-report[.](pdf|jpg|jpeg|png|webp)$'
        )
        && request.resource.contentType.matches(
          '^(application/pdf|image/jpeg|image/png|image/webp)$'
        )
        && metadataKeys.hasAll(['patientId', 'uploadedBy', 'labOrderId'])
        && metadataKeys.hasOnly(['patientId', 'uploadedBy', 'labOrderId'])
        && request.resource.metadata.patientId == patientId
        && request.resource.metadata.uploadedBy == request.auth.uid
        && validReceptionLabOrder(patientId);
    }

    match /pending-reports/{patientId}/{fileName} {
      // Temporary intake is create-only. The trusted finalizer reads, verifies,
      // promotes, and removes this object with generation preconditions.
      allow create: if (isAdmin() || isReception() || isAssignedDoctor(patientId))
        && resource == null
        && validPendingReportCreate(patientId, fileName);
      allow read, update, delete: if false;
    }

    match /reports/{patientId}/{fileName} {
      // Browser reads are always denied. Authorized viewing, printing, and
      // downloading must pass through the same-origin server endpoint so every
      // access is checked against the current assignment and audited first.
      allow read: if false;
      // Only generic clinical documents may be uploaded here by a browser.
      // Reception and every lab-linked upload use pending-reports + finalizer.
      allow create: if (isAdmin() || isAssignedDoctor(patientId))
        && resource == null
        && validClinicalReportCreate(patientId, fileName);

      // Reports use unique object names. Prevent any role from silently
      // replacing the bytes or metadata of an existing clinical document.
      allow update: if false;
      // A failed client acknowledgement is ambiguous: the Firestore record may
      // already exist. Retain immutable uploads for administrator reconciliation.
      // Cleanup and retention must run through an audited trusted service. No
      // browser role can remove the bytes behind a permanent clinical record.
      allow delete: if false;
    }

    match /lab-reports/{patientId}/{fileName} {
      // Finalized laboratory artifacts are a server-only namespace. Browser
      // roles cannot create a colliding object or bypass audited delivery.
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
