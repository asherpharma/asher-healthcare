rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isStaff() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.active == true
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'doctor', 'reception'];
    }

    function isAdmin() {
      return isStaff()
        && firestore.get(/databases/(default)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    match /reports/{patientId}/{fileName} {
      allow read: if isStaff();
      allow create, update: if isStaff()
        && request.resource.size < 10 * 1024 * 1024
        && fileName.matches('.*[.](pdf|jpg|jpeg|png|webp)$')
        && request.resource.contentType.matches('^(application/pdf|image/jpeg|image/png|image/webp)$');
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
